#!/bin/sh
# Refuse a push when a new commit still carries Claude Code attribution.
# Checks only commits that are not already on a remote.

set -u

if [ "${KSM_CLAUDE_ATTRIBUTION_HOOK:-}" = 1 ]; then
  exit 0
fi
export KSM_CLAUDE_ATTRIBUTION_HOOK=1

hook_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd) || exit 1
# shellcheck source=claude-attribution.sh
. "$hook_dir/claude-attribution.sh"

zero=0000000000000000000000000000000000000000
stdin_file=$(mktemp) || exit 1
trap 'rm -f "$stdin_file"' EXIT
cat > "$stdin_file"

common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common_dir=
if [ -n "$common_dir" ]; then
  local_hook="$common_dir/hooks/$(basename "$0")"
  if [ -x "$local_hook" ] && [ "$local_hook" != "$0" ]; then
    "$local_hook" "$@" < "$stdin_file" || exit $?
  fi
fi

refused=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  case "$local_sha" in
    "$zero") continue ;;
  esac

  if [ "$remote_sha" = "$zero" ]; then
    if ! shas=$(git rev-list "$local_sha" --not --remotes); then
      echo "pre-push: could not list commits for $local_ref" >&2
      exit 1
    fi
  else
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "pre-push: $remote_sha is not in this repo, so the attribution check cannot see what this push adds." >&2
      echo "Fetch the remote and push again." >&2
      exit 1
    fi
    # remote..local also lists commits this branch only carries along from
    # another branch, such as origin/main after a merge or rebase. Those
    # already exist on a remote. Check the commits this push actually adds.
    if ! shas=$(git rev-list "$local_sha" --not "$remote_sha" --remotes); then
      echo "pre-push: could not list commits for $local_ref" >&2
      exit 1
    fi
  fi

  for sha in $shas; do
    body=$(git log -1 --format=%B "$sha") || exit 1
    matches=$(printf '%s\n' "$body" | claude_attribution_matches -n)
    status=$?
    if [ "$status" -eq 0 ]; then
      short=$(git rev-parse --short "$sha") || short=$sha
      echo "pre-push: refused $short ($local_ref). It includes a Claude Code attribution line." >&2
      echo "Rewrite that commit so the line is gone, then push again." >&2
      printf '%s\n' "$matches" >&2
      refused=1
    elif [ "$status" -gt 1 ]; then
      echo "pre-push: attribution check failed for $sha." >&2
      exit 1
    fi
  done
done < "$stdin_file"

exit "$refused"
